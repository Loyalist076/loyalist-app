{
  "info": {
    "name": "Loyalist App API",
    "description": "All APIs called from the frontend (public pages + admin pages). Set {{baseUrl}} and, for admin routes, {{token}} (JWT from POST /api/login).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5050" },
    { "key": "token", "value": "" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"John Doe\",\n  \"email\": \"john@example.com\",\n  \"password\": \"password123\",\n  \"role\": \"admin\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/register", "host": ["{{baseUrl}}"], "path": ["api", "register"] }
          }
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"john@example.com\",\n  \"password\": \"password123\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/login", "host": ["{{baseUrl}}"], "path": ["api", "login"] }
          }
        }
      ]
    },
    {
      "name": "Newsletter Subscription",
      "item": [
        {
          "name": "Subscribe",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"subscriber@example.com\",\n  \"source\": \"company\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/subscribe", "host": ["{{baseUrl}}"], "path": ["api", "subscribe"] }
          }
        },
        {
          "name": "List Subscribers (admin)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/api/subscribe", "host": ["{{baseUrl}}"], "path": ["api", "subscribe"] }
          }
        },
        {
          "name": "Delete Subscriber (admin)",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/api/subscribe/:id", "host": ["{{baseUrl}}"], "path": ["api", "subscribe", ":id"], "variable": [{ "key": "id", "value": "1" }] }
          }
        }
      ]
    },
    {
      "name": "News",
      "item": [
        {
          "name": "List News",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/news", "host": ["{{baseUrl}}"], "path": ["api", "news"] }
          }
        },
        {
          "name": "Get News by ID",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/news/:id", "host": ["{{baseUrl}}"], "path": ["api", "news", ":id"], "variable": [{ "key": "id", "value": "1" }] }
          }
        },
        {
          "name": "Create News (admin)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"title\": \"News title\",\n  \"content\": \"News content\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/news", "host": ["{{baseUrl}}"], "path": ["api", "news"] }
          }
        },
        {
          "name": "Update News (admin)",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"title\": \"Updated title\",\n  \"content\": \"Updated content\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/news/:id", "host": ["{{baseUrl}}"], "path": ["api", "news", ":id"], "variable": [{ "key": "id", "value": "1" }] }
          }
        },
        {
          "name": "Delete News (admin)",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/api/news/:id", "host": ["{{baseUrl}}"], "path": ["api", "news", ":id"], "variable": [{ "key": "id", "value": "1" }] }
          }
        }
      ]
    },
    {
      "name": "Contact / Messages",
      "item": [
        {
          "name": "Contact Form (index page)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"John Doe\",\n  \"email\": \"john@example.com\",\n  \"subject\": \"Hello\",\n  \"message\": \"Message body\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/messages/contact/index", "host": ["{{baseUrl}}"], "path": ["api", "messages", "contact", "index"] }
          }
        },
        {
          "name": "Contact Form (business/contact page)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"John Doe\",\n  \"email\": \"john@example.com\",\n  \"subject\": \"Hello\",\n  \"message\": \"Message body\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/messages/contact/business", "host": ["{{baseUrl}}"], "path": ["api", "messages", "contact", "business"] }
          }
        },
        {
          "name": "Contact Form (contact page legacy)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"John Doe\",\n  \"email\": \"john@example.com\",\n  \"subject\": \"Hello\",\n  \"message\": \"Message body\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/contact/page", "host": ["{{baseUrl}}"], "path": ["api", "contact", "page"] }
          }
        },
        {
          "name": "List Messages (admin)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/api/messages", "host": ["{{baseUrl}}"], "path": ["api", "messages"] }
          }
        },
        {
          "name": "Delete Message (admin)",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/api/messages/:id", "host": ["{{baseUrl}}"], "path": ["api", "messages", ":id"], "variable": [{ "key": "id", "value": "1" }] }
          }
        }
      ]
    },
    {
      "name": "Press Release PDFs",
      "item": [
        {
          "name": "List PDFs",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/pdf?t=123456", "host": ["{{baseUrl}}"], "path": ["api", "pdf"], "query": [{ "key": "t", "value": "123456", "description": "cache-buster timestamp" }] }
          }
        },
        {
          "name": "Upload PDF (admin)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "date", "value": "2026-08-05", "type": "text" },
                { "key": "title", "value": "Press release title", "type": "text" },
                { "key": "pdf", "type": "file", "src": "" }
              ]
            },
            "url": { "raw": "{{baseUrl}}/api/pdf/upload", "host": ["{{baseUrl}}"], "path": ["api", "pdf", "upload"] }
          }
        },
        {
          "name": "Delete PDF (admin)",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/api/pdf/:id", "host": ["{{baseUrl}}"], "path": ["api", "pdf", ":id"], "variable": [{ "key": "id", "value": "1" }] }
          }
        }
      ]
    },
    {
      "name": "Financial Statements",
      "item": [
        {
          "name": "List Financials",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/financials", "host": ["{{baseUrl}}"], "path": ["api", "financials"] }
          }
        },
        {
          "name": "Upload Financial Statement (admin)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "title", "value": "Q2 2026 Financial Statement", "type": "text" },
                { "key": "description", "value": "Short description", "type": "text" },
                { "key": "date", "value": "2026-08-05", "type": "text" },
                { "key": "category", "value": "quarterly", "type": "text" },
                { "key": "pdfFile", "type": "file", "src": "" }
              ]
            },
            "url": { "raw": "{{baseUrl}}/api/financials/upload", "host": ["{{baseUrl}}"], "path": ["api", "financials", "upload"] }
          }
        },
        {
          "name": "Delete Financial Statement (admin)",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/api/financials/:id", "host": ["{{baseUrl}}"], "path": ["api", "financials", ":id"], "variable": [{ "key": "id", "value": "1" }] }
          }
        }
      ]
    },
    {
      "name": "Annual Meeting Documents",
      "item": [
        {
          "name": "List Documents by Year (public)",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/annual-meeting-documents/by-year?active=true", "host": ["{{baseUrl}}"], "path": ["api", "annual-meeting-documents", "by-year"], "query": [{ "key": "active", "value": "true" }] }
          }
        },
        {
          "name": "List All Documents by Year (admin)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/api/annual-meeting-documents/by-year", "host": ["{{baseUrl}}"], "path": ["api", "annual-meeting-documents", "by-year"] }
          }
        },
        {
          "name": "Upload Document (admin)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "title", "value": "AGM Notice", "type": "text" },
                { "key": "year", "value": "2026", "type": "text" },
                { "key": "description", "value": "Document description", "type": "text" },
                { "key": "displayOrder", "value": "0", "type": "text" },
                { "key": "pdf", "type": "file", "src": "" }
              ]
            },
            "url": { "raw": "{{baseUrl}}/api/annual-meeting-documents", "host": ["{{baseUrl}}"], "path": ["api", "annual-meeting-documents"] }
          }
        },
        {
          "name": "Toggle Document Active (admin)",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"isActive\": true\n}" },
            "url": { "raw": "{{baseUrl}}/api/annual-meeting-documents/:id", "host": ["{{baseUrl}}"], "path": ["api", "annual-meeting-documents", ":id"], "variable": [{ "key": "id", "value": "1" }] }
          }
        },
        {
          "name": "Delete Document (admin)",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/api/annual-meeting-documents/:id", "host": ["{{baseUrl}}"], "path": ["api", "annual-meeting-documents", ":id"], "variable": [{ "key": "id", "value": "1" }] }
          }
        }
      ]
    },
    {
      "name": "Corporate Presentation",
      "item": [
        {
          "name": "Check Presentation Exists",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/corporate-presentation/check", "host": ["{{baseUrl}}"], "path": ["api", "corporate-presentation", "check"] }
          }
        },
        {
          "name": "Upload Presentation (admin)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "body": { "mode": "formdata", "formdata": [{ "key": "pdf", "type": "file", "src": "" }] },
            "url": { "raw": "{{baseUrl}}/api/corporate-presentation/upload", "host": ["{{baseUrl}}"], "path": ["api", "corporate-presentation", "upload"] }
          }
        }
      ]
    },
    {
      "name": "Company Structure",
      "item": [
        {
          "name": "Get Company Structure",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/company-structure", "host": ["{{baseUrl}}"], "path": ["api", "company-structure"] }
          }
        },
        {
          "name": "Post Company Structure (admin)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"capitalStructure\": \"Capital structure text\",\n  \"shareOwnership\": \"Share ownership text\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/company-structure", "host": ["{{baseUrl}}"], "path": ["api", "company-structure"] }
          }
        }
      ]
    },
    {
      "name": "Upcoming Events",
      "item": [
        {
          "name": "List Events",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/upcoming-events", "host": ["{{baseUrl}}"], "path": ["api", "upcoming-events"] }
          }
        },
        {
          "name": "Create Event (admin)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"title\": \"Annual General Meeting\",\n  \"date\": \"2026-09-15\",\n  \"description\": \"Event description\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/upcoming-events", "host": ["{{baseUrl}}"], "path": ["api", "upcoming-events"] }
          }
        },
        {
          "name": "Update Event (admin)",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"title\": \"Updated event\",\n  \"date\": \"2026-09-20\",\n  \"description\": \"Updated description\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/upcoming-events/:id", "host": ["{{baseUrl}}"], "path": ["api", "upcoming-events", ":id"], "variable": [{ "key": "id", "value": "1" }] }
          }
        },
        {
          "name": "Delete Event (admin)",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/api/upcoming-events/:id", "host": ["{{baseUrl}}"], "path": ["api", "upcoming-events", ":id"], "variable": [{ "key": "id", "value": "1" }] }
          }
        }
      ]
    },
    {
      "name": "Users (admin)",
      "item": [
        {
          "name": "List Users",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/api/users", "host": ["{{baseUrl}}"], "path": ["api", "users"] }
          }
        },
        {
          "name": "Create User",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Jane Doe\",\n  \"email\": \"jane@example.com\",\n  \"password\": \"password123\",\n  \"role\": \"user\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/users", "host": ["{{baseUrl}}"], "path": ["api", "users"] }
          }
        },
        {
          "name": "Update User",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Jane Doe\",\n  \"email\": \"jane@example.com\",\n  \"role\": \"admin\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/users/:id", "host": ["{{baseUrl}}"], "path": ["api", "users", ":id"], "variable": [{ "key": "id", "value": "1" }] }
          }
        },
        {
          "name": "Delete User",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/api/users/:id", "host": ["{{baseUrl}}"], "path": ["api", "users", ":id"], "variable": [{ "key": "id", "value": "1" }] }
          }
        }
      ]
    },
    {
      "name": "Admin Management",
      "item": [
        {
          "name": "List Pending Admins",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/api/admin/pending-admins", "host": ["{{baseUrl}}"], "path": ["api", "admin", "pending-admins"] }
          }
        },
        {
          "name": "Approve Admin",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/api/admin/approve-admin/:adminId", "host": ["{{baseUrl}}"], "path": ["api", "admin", "approve-admin", ":adminId"], "variable": [{ "key": "adminId", "value": "1" }] }
          }
        }
      ]
    }
  ]
}
